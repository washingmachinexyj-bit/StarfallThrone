{
  "Mods": {
    "StarfallThrone": {
      "Items": {
        "SupremeChoice0": { "DisplayName": "初源自选神赐", "Tooltip": "首胜纪念奖励。手持左键切换职业，物品栏右键消耗此匣，获得当前选中的一件武器。\n默认选择近战；没有合成配方，不改变世界击败记录。" },
        "SupremeChoice1": { "DisplayName": "终焰自选神赐", "Tooltip": "首胜纪念奖励。手持左键切换职业，物品栏右键消耗此匣，获得当前选中的一件武器。\n默认选择近战；没有合成配方，不改变世界击败记录。" },
        "SupremeChoice2": { "DisplayName": "无昼自选神赐", "Tooltip": "首胜纪念奖励。手持左键切换职业，物品栏右键消耗此匣，获得当前选中的一件武器。\n默认选择近战；没有合成配方，不改变世界击败记录。" },
        "SupremeWeapon0": {
          "DisplayName": "万生枝冠",
          "Tooltip": "挥出约11格的生命枝刃；挥至中段分出两枚28%伤害的短程枝叶刃。\n一次挥斩对每个目标只命中一次，不可隔墙伤害。"
        },
        "SupremeWeapon1": {
          "DisplayName": "第一场雨",
          "Tooltip": "每次消耗1支箭，在准星附近形成三支各50%伤害的收束雨箭。\n最远50格，起点受视线限制；不保留原弹药的特殊弹体效果。"
        },
        "SupremeWeapon2": {
          "DisplayName": "创世露典",
          "Tooltip": "左键消耗36魔力储存一滴露珠，最多3滴；右键向准星释放全部露珠，每滴125%伤害。\n释放不耗魔；切换到其他物品会散去未释放的露珠。"
        },
        "SupremeWeapon3": {
          "DisplayName": "源生树冠",
          "Tooltip": "召唤源生树冠，占2个仆从栏位。\n每1.5秒向可见目标射出三枚各55%仆从伤害的汇聚露滴；无接触伤害，服从召唤目标标记。"
        },
        "SupremeWeapon4": {
          "DisplayName": "万劫断章",
          "Tooltip": "挥出近身焚誓重刃；普通挥斩命中可积累誓火，最多3层。\n3层时右键消耗全部誓火，挥出200%伤害、约14格的重斩；切换物品清空层数。"
        },
        "SupremeWeapon5": {
          "DisplayName": "焚界六翼",
          "Tooltip": "消耗子弹并转换为终焰弹；连续射击每次增加4%弹体伤害，最多40%。\n持枪停火0.75秒，自动释放一枚75%伤害的余烬并清空热量；切换物品直接散热。"
        },
        "SupremeWeapon6": {
          "DisplayName": "终焰律典",
          "Tooltip": "右键依次切换四律：120%伤害的炽弹、三枚45%伤害的扇形火弹、160%伤害的延迟光束、140%伤害的定点焚印。\n左键每次消耗36魔力；光束预热0.3秒，焚印预热0.5秒；每个目标每次最多命中一次，不能隔墙伤害。"
        },
        "SupremeWeapon7": {
          "DisplayName": "六翼余烬",
          "Tooltip": "召唤炽翼侍从，占2个仆从栏位；每1.2秒射出170%仆从伤害的余烬，无接触伤害。\n右键使自己的炽翼侍从集中攻击2秒，射击间隔缩短至0.7秒；指令冷却10秒。"
        },
        "SupremeWeapon8": {
          "DisplayName": "终命之后",
          "Tooltip": "近身斩击命中积累裁决，最多3层；3层时右键消耗全部裁决，释放220%伤害的定向终斩。\n终斩不追踪，只命中一次；切换物品清空层数，不可隔墙伤害。"
        },
        "SupremeWeapon9": {
          "DisplayName": "最后一束星光",
          "Tooltip": "每次消耗1颗子弹并转换为星光弹。\n连续命中同一目标，每层提高后续弹体伤害3%，最多30%；落空扣2层，3秒未命中或切换物品清空。"
        },
        "SupremeWeapon10": {
          "DisplayName": "未定之书",
          "Tooltip": "右键依次切换：130%伤害的命星、三枚各50%伤害的分岔星、170%伤害的延迟终命光束。\n左键每次消耗36魔力；光束预热0.3秒，长度约41格，每目标命中一次；不能隔墙伤害。"
        },
        "SupremeWeapon11": {
          "DisplayName": "无昼王庭",
          "Tooltip": "召唤唯一的无昼主神侍，占4个仆从栏位；再次使用会替换已有主神侍。\n每秒射出300%仆从伤害的命星，无接触伤害；环绕侍从仅为装饰，不复制伤害。"
        },
        "SupremeArmor0": {
