        },
        "SupremePetItem0": {
          "DisplayName": "First-Dew Companion Memento",
          "Tooltip": "Summon a non-combat vanity companion. Dismiss by cancelling its buff.\nMaster-mode drop."
        },
        "SupremeExpert1": {
          "DisplayName": "Undying Warmth",
          "Tooltip": "Increase all damage by 12%. Every 25 seconds, reduce the next enemy hit by 30%.\nTriggering the guard grants 15% melee, ranged and magic attack speed for four seconds.\nNo reflection or protection from environmental, self-inflicted or PvP damage. Mutually exclusive with earlier accessories of this divine line. Cooldowns persist through death and re-equipping."
        },
        "SupremeMaterial1": {
          "DisplayName": "Final-Flame Oathcore",
          "Tooltip": "Used for this god's mining tool, independent workstation, weapons and Triune armor.\nCraft the ore-free pick and workstation before mining the new ore."
