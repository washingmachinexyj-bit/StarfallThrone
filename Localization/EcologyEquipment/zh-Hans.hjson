{
  "Mods": {
    "StarfallThrone": {
      "Items": {
        "EcologyWeapon0": {
          "DisplayName": "裂雾双刃",
          "Tooltip": "挥出短程弧斩，并在挥动中段射出一道45%伤害的镜光。\n同一时间只能挥动一把；镜光不会触发装备连锁。"
        },
        "EcologyWeapon1": {
          "DisplayName": "镜鹿折弓",
          "Tooltip": "箭矢最多在方块间反弹2次，最多命中2个敌人。\n每发消耗1支对应箭矢或子弹，并转换为专属弹幕；仍计入弹药伤害。"
        },
        "EcologyWeapon2": {
          "DisplayName": "交映棱镜",
          "Tooltip": "同时射出两枚向中间弯折的镜弹，每枚造成65%伤害。"
        },
        "EcologyWeapon3": {
          "DisplayName": "镜背巡游令",
          "Tooltip": "召唤镜背随从：绕行标记后冲刺，周期1.4秒。\n占用1个随从栏位，可取消增益遣散；攻击必须有视线。"
        },
        "EcologyWeapon4": {
          "DisplayName": "封蜡细剑",
          "Tooltip": "向前刺击；首次命中留下固定位置的蜡爆。\n蜡爆在0.5秒后造成65%伤害，半径4格，不随敌人移动。"
        },
        "EcologyWeapon5": {
          "DisplayName": "烛髓长弓",
          "Tooltip": "箭矢首次命中留下固定位置的蜡爆。\n0.5秒后造成65%伤害，半径4格。\n每发消耗1支对应箭矢或子弹，并转换为专属弹幕；仍计入弹药伤害。"
        },
        "EcologyWeapon6": {
          "DisplayName": "长明蜡台",
          "Tooltip": "在鼠标处放置烛台，最多4座，存续6秒。\n每0.9秒向半径4.25格内释放65%伤害的延迟脉冲；放置距离25格。"
        },
        "EcologyWeapon7": {
          "DisplayName": "醒蛹契约",
          "Tooltip": "召唤蜡蛹随从：蓄蜡、发射70%伤害蜡弹后冲刺，周期约1.83秒。\n占用1个随从栏位，可取消增益遣散；攻击必须有视线。"
        },
        "EcologyWeapon8": {
          "DisplayName": "育巢双镰",
          "Tooltip": "交替挥出左右镰斩；每次挥动首次命中放出两根30%伤害蜜针。"
        },
        "EcologyWeapon9": {
          "DisplayName": "蜜棘散射弩",
          "Tooltip": "每次射击发射3根蜜针，每根造成46%伤害。\n蜜针使可中毒的敌人中毒2秒；每轮只消耗1支箭。"
        },
        "EcologyWeapon10": {
          "DisplayName": "琥珀蜂房",
          "Tooltip": "在鼠标处放置蜂房，最多3座，存续6秒。\n每约1.08秒向30格内可见目标发射55%伤害蜜针；放置距离30格。"
        },
        "EcologyWeapon11": {
          "DisplayName": "共巢育蜂杖",
          "Tooltip": "召唤育巢随从：盘旋并在每1.5秒内发射3根55%伤害蜜针。\n占用1个随从栏位，可取消增益遣散；攻击必须有视线。"
        },
        "EcologyWeapon12": {
          "DisplayName": "叩钟锤",
          "Tooltip": "挥动钟锤，并在挥动中段留下55%伤害的延迟声波。\n声波半径4.25格，同一敌人每道声波只受伤一次。"
        },
        "EcologyWeapon13": {
          "DisplayName": "长笛骨弓",
          "Tooltip": "发射宽幅声矢，最多贯穿3个敌人。\n每发消耗1支对应箭矢或子弹，并转换为专属弹幕；仍计入弹药伤害。"
        },
        "EcologyWeapon14": {
          "DisplayName": "无声钟谱",
          "Tooltip": "释放三道错开0.15秒的扩张声环，每道造成48%伤害。\n每道声环只命中同一敌人一次。"
        },
        "EcologyWeapon15": {
          "DisplayName": "送葬摇铃",
          "Tooltip": "召唤空钟随从：先发射55%伤害声弹，再俯冲，周期1.7秒。\n占用1个随从栏位，可取消增益遣散；攻击必须有视线。"
        },
        "EcologyWeapon16": {
          "DisplayName": "逆燃刺枪",
          "Tooltip": "伸出熔枪刺击，中段升起一道45%伤害的逆火。\n逆火向上移动，并施加3秒着火。"
        },
        "EcologyWeapon17": {
          "DisplayName": "冷焰双膛",
          "Tooltip": "交替发射高速冷弹和缓行热弹。\n冷弹贯穿2个敌人；热弹使敌人着火3秒。\n每发消耗1支对应箭矢或子弹，并转换为专属弹幕；仍计入弹药伤害。"
        },
        "EcologyWeapon18": {
          "DisplayName": "倒燃火卷",
          "Tooltip": "在鼠标附近升起三道逆火，各造成55%伤害并施加3秒着火。\n放置点须可见且未被实体方块占据。"
        },
        "EcologyWeapon19": {
          "DisplayName": "熔脊驭兽杖",
          "Tooltip": "召唤熔脊随从：每约1.67秒进行两次对向冲刺。\n占用1个随从栏位，可取消增益遣散；攻击必须有视线。"
        },
        "EcologyWeapon20": {
          "DisplayName": "回旋机齿",
          "Tooltip": "投出会返回的回旋齿轮，并在飞行中射出两枚35%伤害铆钉。\n齿轮对同一敌人重复命中的间隔约0.42秒。"
        },
        "EcologyWeapon21": {
          "DisplayName": "铆钉三连枪",
          "Tooltip": "每轮三发铆钉，每发消耗1颗子弹。\n每第三发贯穿2个敌人；一轮约0.65秒。\n每发消耗1支对应箭矢或子弹，并转换为专属弹幕；仍计入弹药伤害。"
        },
        "EcologyWeapon22": {
          "DisplayName": "磁场布设器",
          "Tooltip": "在鼠标处部署磁场节点，最多2座，存续6秒。\n每0.7秒发射50%伤害铆钉，并让本节点武器的近距离铆钉缓慢转向可见敌人。\n不会影响敌方或其他模组弹幕；放置距离约33.75格。"
        },
        "EcologyWeapon23": {
          "DisplayName": "履带部署信标",
          "Tooltip": "召唤履带炮台随从：跟随部署并每1.8秒发射4枚45%伤害铆钉。\n消耗随从栏位，不属于哨兵。\n占用1个随从栏位，可取消增益遣散；攻击必须有视线。"
        },
        "EcologyWeapon24": {
          "DisplayName": "裂根长鞭剑",
          "Tooltip": "伸缩的近战根索，最长约15格；每次挥动只命中同一敌人一次。\n这是近战武器，不是召唤鞭。"
        },
        "EcologyWeapon25": {
          "DisplayName": "囊种猎弓",
          "Tooltip": "射出受重力影响的种荚。\n命中敌人或方块后留下2秒根芽，最多射出3根弱化种针；种针不会再种根芽。\n每发消耗1支对应箭矢或子弹，并转换为专属弹幕；仍计入弹药伤害。"
        },
        "EcologyWeapon26": {
          "DisplayName": "万胃花种",
          "Tooltip": "在鼠标处种植花球，最多2株，存续6秒。\n每约0.87秒向32.5格内可见敌人发射65%伤害种针；放置距离约33.75格。"
        },
        "EcologyWeapon27": {
          "DisplayName": "抱根使役杖",
          "Tooltip": "召唤抱根随从：从下方突刺并发射60%伤害种针，周期1.6秒。\n占用1个随从栏位，可取消增益遣散；攻击必须有视线。"
        },
        "EcologyWeapon28": {
          "DisplayName": "守陵日轮",
          "Tooltip": "投掷后返回的日轮；折返时放出3道30%伤害日芒。\n日轮对同一敌人重复命中的间隔约0.42秒。"
        },
        "EcologyWeapon29": {
          "DisplayName": "贯日重铳",
          "Tooltip": "射出重型日弹；首次命中向上下两侧各放出一道35%伤害日芒。\n每发消耗1支对应箭矢或子弹，并转换为专属弹幕；仍计入弹药伤害。"
        },
        "EcologyWeapon30": {
          "DisplayName": "三碑连日仪",
          "Tooltip": "在鼠标处展开三角日纹阵，0.4秒预告后以三条光边攻击。\n光阵存续0.9秒；同一敌人受击间隔0.3秒；光边不会穿墙。"
        },
        "EcologyWeapon31": {
          "DisplayName": "负日兽印",
          "Tooltip": "召唤负日兽：蓄势冲撞后射出60%伤害日芒，周期2.1秒。\n占用1个随从栏位，可取消增益遣散；攻击必须有视线。"
        },
        "EcologyWeapon32": {
          "DisplayName": "折潮月刃",
          "Tooltip": "射出沿波浪前进的近战月刃，持续约0.63秒。\n同一时间只能存在一把月刃。"
        },
        "EcologyWeapon33": {
          "DisplayName": "虹纱浪弓",
          "Tooltip": "射出波浪箭，飞行0.4秒后分出两根30%伤害虹针。\n每发消耗1支对应箭矢或子弹，并转换为专属弹幕；仍计入弹药伤害。"
        },
        "EcologyWeapon34": {
          "DisplayName": "珠泡法典",
          "Tooltip": "射出缓行虹泡，0.7秒后朝可见目标裂成3根55%伤害虹针。\n虹泡本身没有接触伤害。"
        },
        "EcologyWeapon35": {
          "DisplayName": "虹鳍织潮杖",
          "Tooltip": "召唤虹鳍随从：摆动射出两根45%伤害虹针，再俯冲，周期约1.73秒。\n占用1个随从栏位，可取消增益遣散；攻击必须有视线。"
        },
        "EcologyWeapon36": {
          "DisplayName": "失轨星刃",
          "Tooltip": "星刃先环绕玩家0.4秒，再沿施放方向射出。\n同一时间只能存在一把；每个敌人只受击一次。"
        },
        "EcologyWeapon37": {
          "DisplayName": "相隙步枪",
          "Tooltip": "发射可贯穿3个敌人的相弹。\n飞行0.3秒后尝试沿前方跳过至多10格的空隙；不能穿过实体墙。\n每发消耗1支对应箭矢或子弹，并转换为专属弹幕；仍计入弹药伤害。"
        },
        "EcologyWeapon38": {
          "DisplayName": "对门星标",
          "Tooltip": "建立入口与鼠标处出口，最多相距37.5格。\n出口在0.3、约0.43、约0.57秒各发射一枚50%伤害星弹。\n两端必须可见；不会传送玩家，出口被挡时不射击。"
        },
        "EcologyWeapon39": {
          "DisplayName": "巡星御环",
          "Tooltip": "召唤巡星随从：绕敌、突进、短距换位后发射两枚45%伤害星弹，周期约1.67秒。\n占用1个随从栏位，可取消增益遣散；攻击必须有视线。"
        },
