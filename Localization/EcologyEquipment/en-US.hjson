{
  "Mods": {
    "StarfallThrone": {
      "Items": {
        "EcologyWeapon0": {
          "DisplayName": "Riftmist Twinblade",
          "Tooltip": "Sweep a short arc and release a 45% damage mirror crescent halfway through. One blade at a time; the crescent is secondary."
        },
        "EcologyWeapon1": {
          "DisplayName": "Mirrorhart Bow",
          "Tooltip": "Arrows bounce from tiles twice and penetrate two enemies.\nConsumes one matching arrow or bullet per shot and converts its projectile; ammunition damage still applies."
        },
        "EcologyWeapon2": {
          "DisplayName": "Crossing Prism",
          "Tooltip": "Fire two inward-curving mirror bolts, each dealing 65% damage."
        },
        "EcologyWeapon3": {
          "DisplayName": "Mirrorback Writ",
          "Tooltip": "Summon a mirrorback attendant that circles then dashes. Cycle: 1.4 seconds.\nUses 1 minion slot. Dismiss via its buff. All attacks require line of sight."
        },
        "EcologyWeapon4": {
          "DisplayName": "Waxseal Rapier",
          "Tooltip": "Thrust forward. The first hit leaves a stationary wax burst: 65% damage after 0.5 seconds, radius 4 tiles."
        },
        "EcologyWeapon5": {
          "DisplayName": "Candle Marrow Bow",
          "Tooltip": "An arrow's first hit leaves a stationary wax burst: 65% damage after 0.5 seconds, radius 4 tiles.\nConsumes one matching arrow or bullet per shot and converts its projectile; ammunition damage still applies."
        },
        "EcologyWeapon6": {
          "DisplayName": "Vigil Candle",
          "Tooltip": "Place up to four candles for 6 seconds within 25 visible tiles. Every 0.9 seconds each releases a delayed 65% damage pulse, radius 4.25 tiles."
        },
        "EcologyWeapon7": {
          "DisplayName": "Awakened Pupa Pact",
          "Tooltip": "Summon a pupa that charges, fires a 70% damage bolt, then dashes. Cycle: about 1.83 seconds.\nUses 1 minion slot. Dismiss via its buff. All attacks require line of sight."
        },
        "EcologyWeapon8": {
          "DisplayName": "Brood Scythes",
          "Tooltip": "Alternate left and right scythes. The first hit per swing releases two 30% damage needles."
        },
        "EcologyWeapon9": {
          "DisplayName": "Honeythorn Crossbow",
          "Tooltip": "Fire three honey needles at 46% damage each, poisoning susceptible enemies for 2 seconds. Only one arrow is consumed per volley."
        },
        "EcologyWeapon10": {
          "DisplayName": "Amber Hive",
          "Tooltip": "Place up to three hives for 6 seconds within 30 visible tiles. Every 1.08 seconds each fires a 55% damage needle at a visible target within 30 tiles."
        },
        "EcologyWeapon11": {
          "DisplayName": "Communal Apiary Staff",
          "Tooltip": "Summon a circling attendant firing three 55% damage needles per 1.5-second cycle.\nUses 1 minion slot. Dismiss via its buff. All attacks require line of sight."
        },
        "EcologyWeapon12": {
          "DisplayName": "Knell Hammer",
          "Tooltip": "Sweep a hammer and leave a delayed 55% damage sound pulse. Radius: 4.25 tiles; each pulse hits an enemy once."
        },
        "EcologyWeapon13": {
          "DisplayName": "Boneflute Bow",
          "Tooltip": "Fire a wide sound arrow that penetrates three enemies.\nConsumes one matching arrow or bullet per shot and converts its projectile; ammunition damage still applies."
        },
        "EcologyWeapon14": {
          "DisplayName": "Silent Bell Score",
          "Tooltip": "Fire three expanding sound rings delayed by 0.15 seconds, each at 48% damage. Each ring hits an enemy once."
        },
        "EcologyWeapon15": {
          "DisplayName": "Funeral Chime",
          "Tooltip": "Summon an attendant firing a 55% damage sound bolt, then diving. Cycle: 1.7 seconds.\nUses 1 minion slot. Dismiss via its buff. All attacks require line of sight."
        },
        "EcologyWeapon16": {
          "DisplayName": "Backburn Lance",
          "Tooltip": "Thrust forward and raise a 45% damage flame halfway through. Rising flames inflict On Fire for 3 seconds."
        },
        "EcologyWeapon17": {
          "DisplayName": "Coldflame Twinbore",
          "Tooltip": "Alternate fast cold rounds and slow hot rounds. Cold penetrates two enemies; hot inflicts On Fire for 3 seconds.\nConsumes one matching arrow or bullet per shot and converts its projectile; ammunition damage still applies."
        },
        "EcologyWeapon18": {
          "DisplayName": "Inverted Fire Scroll",
          "Tooltip": "Raise three flames around the cursor at 55% damage each, inflicting On Fire for 3 seconds. Spawn points must be visible and unobstructed."
        },
        "EcologyWeapon19": {
          "DisplayName": "Emberback Staff",
          "Tooltip": "Summon an emberback making two opposing dashes every 1.67 seconds.\nUses 1 minion slot. Dismiss via its buff. All attacks require line of sight."
        },
        "EcologyWeapon20": {
          "DisplayName": "Returning Cog",
          "Tooltip": "Throw a returning cog that fires two 35% damage rivets. Repeat cog hits on the same enemy require about 0.42 seconds."
        },
        "EcologyWeapon21": {
          "DisplayName": "Rivet Burstgun",
          "Tooltip": "Fire three-round bursts, consuming a bullet per round. Every third round penetrates two enemies. Burst cycle: about 0.65 seconds.\nConsumes one matching arrow or bullet per shot and converts its projectile; ammunition damage still applies."
        },
        "EcologyWeapon22": {
          "DisplayName": "Magnetic Deployer",
          "Tooltip": "Deploy up to two magnetic nodes for 6 seconds within 33.75 visible tiles. Every 0.7 seconds each fires a 50% damage rivet and guides this weapon's nearby rivets toward visible foes. Never redirects hostile or foreign projectiles."
        },
        "EcologyWeapon23": {
          "DisplayName": "Crawler Beacon",
          "Tooltip": "Summon a mobile turret attendant firing four 45% damage rivets per 1.8-second cycle. Uses a minion slot, not a sentry slot.\nUses 1 minion slot. Dismiss via its buff. All attacks require line of sight."
        },
        "EcologyWeapon24": {
          "DisplayName": "Rootrending Lashblade",
          "Tooltip": "Extend and retract a melee root lash up to about 15 tiles. Each swing hits each enemy once. This is melee, not a summon whip."
        },
        "EcologyWeapon25": {
          "DisplayName": "Podseed Bow",
          "Tooltip": "Fire a gravity-affected seed pod. Impact grows a two-second bud firing up to three weakened needles. Needles cannot grow further buds.\nConsumes one matching arrow or bullet per shot and converts its projectile; ammunition damage still applies."
        },
        "EcologyWeapon26": {
          "DisplayName": "Manymaw Bulb",
          "Tooltip": "Plant up to two bulbs for 6 seconds within 33.75 visible tiles. Every 0.87 seconds each fires a 65% damage needle at a visible target within 32.5 tiles."
        },
        "EcologyWeapon27": {
          "DisplayName": "Rootbound Pact",
          "Tooltip": "Summon a root attendant that thrusts from below and fires a 60% damage needle. Cycle: 1.6 seconds.\nUses 1 minion slot. Dismiss via its buff. All attacks require line of sight."
        },
        "EcologyWeapon28": {
          "DisplayName": "Tombwarden Sunwheel",
          "Tooltip": "Throw a returning sunwheel that releases three 30% damage rays when returning. Repeat hits require about 0.42 seconds."
        },
        "EcologyWeapon29": {
          "DisplayName": "Sunpiercer Cannon",
          "Tooltip": "A heavy round's first hit releases two vertical rays at 35% damage each.\nConsumes one matching arrow or bullet per shot and converts its projectile; ammunition damage still applies."
        },
        "EcologyWeapon30": {
          "DisplayName": "Three Stele Orrery",
          "Tooltip": "Place a triangular solar array at the cursor. After a 0.4-second warning its three edges strike. Lifetime: 0.9 seconds; repeat-hit interval: 0.3 seconds. Edges cannot cross walls."
        },
        "EcologyWeapon31": {
          "DisplayName": "Sunburden Seal",
          "Tooltip": "Summon a sunburden beast that charges then fires a 60% damage ray. Cycle: 2.1 seconds.\nUses 1 minion slot. Dismiss via its buff. All attacks require line of sight."
        },
        "EcologyWeapon32": {
          "DisplayName": "Tidefold Crescent",
          "Tooltip": "Release a wave-moving melee crescent lasting about 0.63 seconds. Only one crescent at a time."
        },
        "EcologyWeapon33": {
          "DisplayName": "Rainbow Wavebow",
          "Tooltip": "Fire a wave arrow that splits off two 30% damage prism needles after 0.4 seconds.\nConsumes one matching arrow or bullet per shot and converts its projectile; ammunition damage still applies."
        },
        "EcologyWeapon34": {
          "DisplayName": "Pearlbubble Grimoire",
          "Tooltip": "Release a slowing bubble that bursts after 0.7 seconds into three 55% damage needles aimed toward a visible target. The bubble itself cannot hurt."
        },
        "EcologyWeapon35": {
          "DisplayName": "Prismfin Staff",
          "Tooltip": "Summon a prismfin that sways, fires two 45% damage needles, then dives. Cycle: about 1.73 seconds.\nUses 1 minion slot. Dismiss via its buff. All attacks require line of sight."
        },
        "EcologyWeapon36": {
          "DisplayName": "Derailing Starblade",
          "Tooltip": "Orbit a blade around yourself for 0.4 seconds, then launch it in the original aim direction. One blade at a time; hits each enemy once."
        },
        "EcologyWeapon37": {
          "DisplayName": "Phasegap Rifle",
          "Tooltip": "Fire a phase round penetrating three enemies. After 0.3 seconds it attempts a forward gap-step of up to 10 tiles. It cannot cross solid walls.\nConsumes one matching arrow or bullet per shot and converts its projectile; ammunition damage still applies."
        },
        "EcologyWeapon38": {
          "DisplayName": "Paired Gate Marker",
          "Tooltip": "Open entry and cursor exit gates within 37.5 visible tiles. The exit fires three 50% damage bolts at 0.3, 0.43 and 0.57 seconds. Never teleports players; blocked exits do not fire."
        },
        "EcologyWeapon39": {
          "DisplayName": "Starwarden Ring",
          "Tooltip": "Summon an orbiting, dashing star attendant that repositions then fires two 45% damage bolts. Cycle: about 1.67 seconds.\nUses 1 minion slot. Dismiss via its buff. All attacks require line of sight."
        },
