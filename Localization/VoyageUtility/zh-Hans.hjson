{
  "Mods": {
    "StarfallThrone": {
      "Items": {
        "VoyageUtility0": {
          "DisplayName": "货运终端",
          "Tooltip": "可放置\n右键打开 40 格个人货运仓库，所有货运终端共用\n仓库随角色保存；拆除终端不会掉出或清空仓库\n支持左键交换、右键拆分、Shift 点击取出及手动快速堆叠\n不会自动收走背包物品"
        },
        "VoyageUtility1": {
          "DisplayName": "远望探照器",
          "Tooltip": "召唤一台巡天探照无人机\n占用照明宠物栏，不占仆从栏；不造成伤害\n跟随玩家，并照亮前方短距离，光束不会穿过实体方块"
        },
        "VoyageUtility2": {
          "DisplayName": "环带工程钻",
          "Tooltip": "350% 镐力，工具射程增加 6 格\n持续使用进行精确采掘，可开采环骸矿\n在航行工作台用星骸甲片、环带引力核和寂月锭制作\n不进行范围挖掘，不绕过方块的挖掘条件"
        },
        "VoyageUtility3": {
          "DisplayName": "蜂巢维修站",
          "Tooltip": "可放置\n右键获得 10 分钟的「王庭维护」增益\n增加 10 点防御和 40 点最大魔力\n重复使用只刷新时间，不叠加效果，也不治疗生命"
        },
        "VoyageUtility4": {
          "DisplayName": "回航定位器",
          "Tooltip": "按住使用键并站定 2 秒，返回有效床位或世界出生点附近\n移动、受伤、松开按键或切换物品会中断定位\nBoss、小 Boss、入侵及月亮事件期间无法使用\n不会给予无敌或恢复生命，不会改变地形"
        },
        "VoyageUtility5": {
          "DisplayName": "恒生生态灯",
          "Tooltip": "可放置\n散发柔和的翠绿色光芒，可作为房屋照明\n封装的星际生态样本仅供观赏\n不会扩散生物群系或改变环境"
        },
        "VoyageUtility6": {
          "DisplayName": "先驱建造仪",
          "Tooltip": "饰品\n增加 4 格放置范围，提升 50% 方块与墙壁放置速度\n持有建材时显示放置轮廓与距离提示\n青色只表示在射程内；实际放置仍需满足支撑与空间条件\n正常消耗建材，不允许免费放置"
        },
        "VoyageUtility7": {
          "DisplayName": "星图测绘台",
          "Tooltip": "可放置\n右键查看星海远征的 17 条 Boss 航线\n显示击败记录、召唤解锁条件、材料用途、武器及护甲阶段\n多人模式读取当前世界同步的击败记录"
        },
        "VoyageUtility8": {
          "DisplayName": "微型方舟陈列台",
          "Tooltip": "可放置\n右键依次切换「方舟外壳」「轨道阵列」「人工恒星」三种陈列状态\n状态保存在家具方块中，并在多人游戏中同步\n仅供观赏，不提供战斗增益"
        },
        "VoyageFurniture0": {
          "DisplayName": "星港航徽挂饰",
          "Tooltip": "可放置在背景墙上\n对应 Boss 的航徽装饰，无战斗效果"
        },
        "VoyageFurniture1": {
          "DisplayName": "星港标本灯",
          "Tooltip": "可放置\n散发对应航线的主题光芒，可作为房屋照明"
        },
        "VoyageFurniture2": {
