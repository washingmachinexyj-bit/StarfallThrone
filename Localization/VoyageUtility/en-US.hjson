{
  "Mods": {
    "StarfallThrone": {
      "Items": {
        "VoyageUtility0": {
          "DisplayName": "Cargo Terminal",
          "Tooltip": "Placeable\nRight-click to open a 40-slot personal cargo hold shared by all Cargo Terminals\nSaved with your character; breaking a terminal never spills or clears the hold\nLeft-click swaps, right-click splits, Shift-click withdraws; manual Quick Stack supported\nNever automatically imports inventory items"
        },
        "VoyageUtility1": {
          "DisplayName": "Farwatch Searchlight",
          "Tooltip": "Summons a survey searchlight drone\nUses the light-pet slot, not minion slots; deals no damage\nFollows you and lights a short path ahead without shining through solid blocks"
        },
        "VoyageUtility2": {
          "DisplayName": "Belt Engineering Drill",
          "Tooltip": "350% pickaxe power and +6 tile tool reach\nHold to mine precisely, including Ringwreck Ore\nCraft at the Voyage Workbench using Belt materials, its gravity core and Silentmoon ingots\nNo area mining and no bypassing block mining requirements"
        },
        "VoyageUtility3": {
          "DisplayName": "Hive Repair Station",
          "Tooltip": "Placeable\nRight-click for 10 minutes of Royal Maintenance\nGrants +10 defense and +40 maximum mana\nRepeated use refreshes the timer, does not stack, and does not heal"
        },
        "VoyageUtility4": {
          "DisplayName": "Homeward Locator",
          "Tooltip": "Hold use while standing still for 2 seconds to return near a valid bed or world spawn\nMovement, damage, releasing use or changing items interrupts recall\nDisabled during bosses, minibosses, invasions and moon events\nGrants no immunity or healing and never modifies terrain"
        },
        "VoyageUtility5": {
          "DisplayName": "Everliving Ecology Lamp",
          "Tooltip": "Placeable\nProvides soft green illumination and counts as a housing light\nA sealed specimen of interstellar ecology\nDoes not spread biomes or alter the environment"
        },
        "VoyageUtility6": {
          "DisplayName": "Precursor Builder",
          "Tooltip": "Accessory\n+4 tile placement reach and +50% block/wall placement speed\nDisplays a footprint and range guide while holding building materials\nCyan means within reach only; anchors and space must still permit placement\nConsumes building materials normally"
        },
        "VoyageUtility7": {
          "DisplayName": "Star Chart Table",
          "Tooltip": "Placeable\nRight-click to inspect all 17 Star Voyage encounters\nShows kills, summon prerequisites, material uses, weapons and armor milestones\nUses the synchronized progression of the current multiplayer world"
        },
        "VoyageUtility8": {
          "DisplayName": "Miniature Ark Display",
          "Tooltip": "Placeable\nRight-click to cycle Ark Hull, Orbital Array and Artificial Star displays\nIts state is saved in the furniture tiles and synchronized in multiplayer\nPurely decorative; grants no combat benefits"
        },
        "VoyageFurniture0": {
