      CosmicHeart.DisplayName: "Cosmic Heart"
      ImperialGelShield.Tooltip: "+8 defense, +6% generic damage, and +2% generic crit; +100 max life, +2 life regeneration, and immunity to knockback."
      PhaseEyeCore.Tooltip: "+8 defense, +6.4% generic damage, and +2% generic crit; additionally grants +8% generic damage and +8% generic crit."
      DevourerMagnet.Tooltip: "+8 defense, +6.8% generic damage, and +2% generic crit; +18% move speed and another +10% generic damage."
      IllusionHeart.Tooltip: "+9 defense, +7.2% generic damage, and +2% generic crit; +6% damage reduction and immunity to Confused."
      HiveHeart.Tooltip: "+9 defense, +7.6% generic damage, and +3% generic crit; +2 minion slots and +14% summon damage."
      JudgeMask.Tooltip: "+21 defense, +8% generic damage, and +3% generic crit; +12% melee damage."
      SoulHinge.Tooltip: "+10 defense, +8.4% generic damage, and +3% generic crit; +100 max mana and 18% lower mana cost."
      PrismWing.Tooltip: "+10 defense, +8.8% generic damage, and +3% generic crit; +45 wing time and +12% move speed."
      PolarEngine.Tooltip: "+10 defense, +9.2% generic damage, and +4% generic crit; +15% ranged damage and +7% ranged crit."
      FourArmProtocol.Tooltip: "+11 defense, +9.6% generic damage, and +4% generic crit; +1 sentry slot and another +12% generic damage."
      MagneticCoil.Tooltip: "+11 defense, +10% generic damage, +4% generic crit, and +1% damage reduction; another +12% generic damage."
      WorldRoot.Tooltip: "+11 defense, +10.4% generic damage, +4% generic crit, and +1% damage reduction; +4 life regeneration and immunity to Poisoned."
      TitanPrism.Tooltip: "+22 defense, +10.8% generic damage, +5% generic crit, and +1% damage reduction; +140 max life."
      TideEngine.Tooltip: "+12 defense, +11.2% generic damage, +5% generic crit, and +1% damage reduction; +22% move speed, water walking, and water immunity."
      CoronaCrown.Tooltip: "+12 defense, +11.6% generic damage, +5% generic crit, and +1% damage reduction; +120 max mana and +16% magic damage."
      FourPillarEdict.Tooltip: "+13 defense, +12% generic damage, +5% generic crit, and +1% damage reduction; +1 minion, +1 sentry, and another +10% generic damage."
      CosmicHeart.Tooltip: "+13 defense, +12.4% generic damage, +6% generic crit, and +7% damage reduction; +200 max life, +100 max mana, and another +15% generic damage."
      ImperialScepter.DisplayName: "Imperial Scepter"
      ImperialScepter.Tooltip: "Swings the gel scepter; every second swing lobs a falling gel sac"
      PhaseBreaker.DisplayName: "Phase Breaker"
      PhaseBreaker.Tooltip: "Charges for 18 frames, then fires a brief piercing ray blocked by solid tiles\nConsumes 1 bullet per use, converting it to the weapon's own projectile"
      DevourerLance.DisplayName: "Devourer Lance"
      DevourerLance.Tooltip: "Extends and retracts a long void thrust; hits each target once per thrust"
      MindCircuit.DisplayName: "Mind Circuit"
      MindCircuit.Tooltip: "Places three thought orbs toward the cursor; they orbit briefly, then converge"
      RoyalStinger.DisplayName: "Royal Stinger"
      RoyalStinger.Tooltip: "Fires three stinger arrows, each releasing two weaker seeking stingers on impact\nConsumes 1 arrow per use, converting it to the weapon's own projectile"
      JudgmentCodex.DisplayName: "Judgment Codex"
      JudgmentCodex.Tooltip: "Places three bone blades above the aimed point; they fall after a brief warning"
      EternalTendril.DisplayName: "Eternal Tendril"
      EternalTendril.Tooltip: "Sweeps a wide flesh tendril, applying Ichor for 3 seconds"
      DynastyPrism.DisplayName: "Dynasty Prism Cannon"
      DynastyPrism.Tooltip: "Throws a prism that refracts into three terrain-blocked rays"
      TwinRayCannon.DisplayName: "Twin-Ray Cannon"
      TwinRayCannon.Tooltip: "Charges for 12 frames, then fires two parallel rays at 55% damage each\nConsumes 1 bullet per use, converting it to the weapon's own projectile"
      PrimeSaw.DisplayName: "Prime Saw"
      PrimeSaw.Tooltip: "Throws a spinning saw that returns and can hit on both legs"
      StarChainDrill.DisplayName: "Star-Chain Drill"
      StarChainDrill.Tooltip: "Extends a long chain drill; hits the same target at most once every 9 frames"
      FlowerThornCrown.DisplayName: "Flower Thorn Crown"
      FlowerThornCrown.Tooltip: "Summons a following thorn bloom that fires three seeking thorns\nUses 1 minion slot; right-click targets, dismiss through its buff"
      TempleRiftCannon.DisplayName: "Temple Rift Cannon"
      TempleRiftCannon.Tooltip: "Fires a heavy prism shell that explodes into four cardinal fragments\nConsumes 1 bullet per use, converting it to the weapon's own projectile"
      AbyssalHarpoon.DisplayName: "Abyssal Harpoon"
      AbyssalHarpoon.Tooltip: "Throws and retrieves an abyssal harpoon; its first impact releases a tidal ring\nRequires no ammunition"
      CoronaPrismWeapon.DisplayName: "Corona Prism"
      CoronaPrismWeapon.Tooltip: "Fires five light stars with limited-duration homing"
      PontiffStarbook.DisplayName: "Pontiff's Starbook"
      PontiffStarbook.Tooltip: "Places an astral sentry that fires four star bolts at targets\nUses a sentry slot; lasts 2 minutes and respects the sentry cap"
      EndMoonWeapon.DisplayName: "End Moon Lance"
      EndMoonWeapon.Tooltip: "Fires a moon arrow that releases two seeking shards after a short flight or impact\nConsumes 1 arrow per use, converting it to the weapon's own projectile"
      ThroneAegis.DisplayName: "Throne Aegis"
      VoidstepInsignia.DisplayName: "Voidstep Insignia"
      AstralConductor.DisplayName: "Astral Conductor"
      Thronebreaker.DisplayName: "Thronebreaker"
      Thronebreaker.Tooltip: "Alternating heavy slashes; every third slash adds a brief thronebreaking ray"
      AstralThroneHelmet.DisplayName: "Astral Throne Helmet"
      AstralThroneHelmet.Tooltip: "Head armor from the Astral Throne set."
      AstralThroneHelmet.SetBonus: "Astral Throne: +250 max life, +120 max mana, 15% increased generic damage, 8% damage reduction, +1 minion, +1 sentry, and immunity to knockback."
      AstralThronePlate.DisplayName: "Astral Throne Plate"
      AstralThronePlate.Tooltip: "Body armor from the Astral Throne set."
      AstralThroneGreaves.DisplayName: "Astral Throne Greaves"
      AstralThroneGreaves.Tooltip: "Leg armor from the Astral Throne set."
