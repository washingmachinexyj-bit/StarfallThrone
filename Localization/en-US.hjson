      AstralExplorerHelmet.Tooltip: "Head armor from the Meteoric Dawn set."
      AstralExplorerHelmet.SetBonus: "Meteoric Dawn: +5% generic damage, higher jumps, and immunity to fall damage."
      AstralExplorerChest.DisplayName: "Astral Explorer Chestplate"
      AstralExplorerChest.Tooltip: "Body armor from the Meteoric Dawn set."
      AstralExplorerGreaves.DisplayName: "Astral Explorer Greaves"
      AstralExplorerGreaves.Tooltip: "Leg armor from the Meteoric Dawn set."
      ResinShortbow.Tooltip: "Fires a falling resin arrow that slows on hit for 2 seconds\nConsumes 1 arrow per use, converting it to the weapon's own projectile"
      ResinCane.Tooltip: "Lobs a sap sac that leaves a short-lived sticky field"
      CopperveinRepeater.Tooltip: "One arrow fires three copper bolts 6 frames apart, each dealing 55% damage\nConsumes 1 arrow per use, converting it to the weapon's own projectile"
      MinebreakerDrill.Tooltip: "Extends a short drill for repeated thrust hits; cannot mine"
      BellstingSpear.Tooltip: "Extends and retracts a scorpion spear, poisoning on hit"
      SandglassStaff.Tooltip: "Lobs a falling sand orb that breaks into four grains"
      FrostfangBlade.Tooltip: "Alternating slashes; every third slash releases an ice fang and inflicts Frostburn"
      FrostHowl.Tooltip: "Releases an expanding forward frost arc, not a full circle"
      MireSprayer.Tooltip: "Sprays three lingering poison clouds; each cloud hits at most once every 30 frames"
      TongueWhip.Tooltip: "Swings a tongue whip, marking targets for 4 seconds\nMinions and sentries deal 3 extra tag damage to marked targets"
      WaxenRepeater.Tooltip: "Wax arrows release two seeking stingers on impact\nConsumes 1 arrow per use, converting it to the weapon's own projectile"
      WaxVerdict.Tooltip: "Summons a wax bee that pursues and periodically dashes\nUses 1 minion slot; right-click targets, dismiss through its buff"
      RootlashHook.Tooltip: "Thrusts three root hooks in a fan at 48% damage each; not a traversal hook"
      RotrootStaff.Tooltip: "Throws a rotten seed that creates a short-lived root field on impact"
      GravebellFlail.Tooltip: "Throws and retrieves a chained bell; its first impact releases an expanding ring"
      KeybearerCrossbow.Tooltip: "Fires a bone-key arrow with 3 penetrations and brief gentle homing\nConsumes 1 arrow per use, converting it to the weapon's own projectile"
      MeteorMawCannon.Tooltip: "Fires a heavy meteor shell with impact splash damage\nRequires no ammunition"
      StarEaterStaff.Tooltip: "Throws a returning star; only one can be thrown at a time"
      DawnstarEdge.Tooltip: "Alternating star slashes; every third slash adds a seeking star blade"
      FirstlightCodex.Tooltip: "Expands a ring from the casting position; hits each target at most once"
      DawnpiercerBow.Tooltip: "Dawn arrows release two seeking star shards on impact\nConsumes 1 arrow per use, converting it to the weapon's own projectile"
      ResinHeart.Tooltip: "Immune to Slow; taking damage grants +10% move speed for 2 seconds."
      OreseekerScanner.Tooltip: "+10% mining speed."
      SandstepAnklet.Tooltip: "+12% move speed and increased running speed."
      FroststepMantle.Tooltip: "Immune to Chilled; +8% move speed."
      MirelungCharm.Tooltip: "Gills, swimming, and immunity to Poisoned."
      WaxwingSigil.Tooltip: "+1 minion slot and +0.5 seconds of wing time."
      RootboundTalisman.Tooltip: "Standing still grants 3 defense."
      GatekeeperAmulet.Tooltip: "+2% damage reduction."
      MagneticHarness.Tooltip: "Immunity to fall damage; +4% ranged and magic damage."
      DawnshardCrown.Tooltip: "+5% generic damage; taking damage briefly grants more speed and damage."
    }
    Tiles: {
      StarfallRelicTile.MapEntry: "Starfall Relic"
      StarfallTrophyTile.MapEntry: "Starfall Trophy"
    }
    BossChecklist: {
      SlimeEmperor: { SpawnInfo: "Use an Emperor Crown after defeating the Moon Lord." DespawnMessage: "The imperial gel dissolves into the stars." }
      TerminalEye: { SpawnInfo: "Use a Terminal Eye after defeating the Slime Emperor." DespawnMessage: "The terminal eye loses its target." }
      InfiniteDevourer: { SpawnInfo: "Use Infinite Bait after defeating the Terminal Eye." DespawnMessage: "The void worm retreats below the world." }
      CrimsonMind: { SpawnInfo: "Use a Crimson Heart after defeating the Infinite Devourer." DespawnMessage: "The crimson thoughts fade away." }
      BeeMatriarch: { SpawnInfo: "Use a Royal Bee Sigil after defeating the Crimson Mind." DespawnMessage: "The royal hive goes silent." }
      SkeletalJudge: { SpawnInfo: "Use a Judgment Boneflute at night after defeating the Bee Matriarch." DespawnMessage: "The judgment is postponed." }
      EternalWall: { SpawnInfo: "Use an Eternal Voodoo Doll in the Underworld after defeating the Skeletal Judge." DespawnMessage: "The eternal wall returns to the ash." }
      DynastyQueen: { SpawnInfo: "Use a Dynasty Prism after defeating the Eternal Wall." DespawnMessage: "The prism throne collapses." }
      TwinCalamity: { SpawnInfo: "Use Twin Omen after defeating the Dynasty Queen." DespawnMessage: "The twin engines lose synchronization." }
      PrimeVerdict: { SpawnInfo: "Use Prime Verdict after defeating the Twin Calamity." DespawnMessage: "The mechanical verdict is withdrawn." }
      StarEater: { SpawnInfo: "Use Star Eater Worm after defeating Prime Verdict." DespawnMessage: "The star eater burrows into the void." }
      WastelandFlower: { SpawnInfo: "Use a Wasteland Bud in the Underground Jungle after defeating the Star Eater." DespawnMessage: "The flower returns to dormant roots." }
      TempleCore: { SpawnInfo: "Use a Temple Star Core inside the Lihzahrd Temple after defeating the Wasteland Flower." DespawnMessage: "The temple core seals itself." }
      AbyssalDuke: { SpawnInfo: "Use an Abyss Lure in the Ocean after defeating the Temple Core." DespawnMessage: "The abyssal tide swallows the duke." }
      CoronaEmpress: { SpawnInfo: "Use a Corona Butterfly in the Hallow after defeating the Abyssal Duke." DespawnMessage: "The corona fades beyond the horizon." }
      AstralPontiff: { SpawnInfo: "Use Astral Scripture at the Dungeon after defeating the Corona Empress." DespawnMessage: "The astral sermon ends." }
      EndMoon: { SpawnInfo: "Use End Moon Rite after defeating the Astral Pontiff." DespawnMessage: "The end moon leaves the battlefield." }
      ResinWhelp: { SpawnInfo: "Use a Resin Acorn." DespawnMessage: "The resin whelp retreats into the roots." }
      CopperveinScarab: { SpawnInfo: "Use a Smelted Carapace after defeating the Resin Whelp." DespawnMessage: "The coppervein scarab burrows underground." }
      BellscorpionMatriarch: { SpawnInfo: "Use a Sand Bell after defeating the Coppervein Scarab." DespawnMessage: "The bellscorpion matriarch vanishes into the sand." }
      FrosthornStalker: { SpawnInfo: "Use a Frosthorn Bone Flute after defeating the Bellscorpion Matriarch." DespawnMessage: "The frosthorn stalker flees into the snow." }
      LanternMiretoad: { SpawnInfo: "Use Mire Lantern Bait after defeating the Frosthorn Stalker." DespawnMessage: "The lantern miretoad sinks into the bog." }
      WaxenArbiter: { SpawnInfo: "Use a Wax Seal after defeating the Lantern Miretoad." DespawnMessage: "The waxen arbiter returns to the hive." }
      RotrootWeaver: { SpawnInfo: "Use an Evil Root Totem after defeating the Waxen Arbiter." DespawnMessage: "The rotroot weaver hides in the evil roots." }
      GravebellKeybearer: { SpawnInfo: "Use a Gravebell Key after defeating the Rotroot Weaver." DespawnMessage: "The gravebell keybearer retreats beyond the tomb gate." }
      MeteorMaw: { SpawnInfo: "Use a Meteor Gizzard after defeating the Gravebell Keybearer." DespawnMessage: "The meteor maw swallows the last star." }
      DawnshardScion: { SpawnInfo: "Use a Dawnshard Sigil after defeating the Meteor Maw." DespawnMessage: "The dawnshard scion fades before dawn." }
    }
  }
}
