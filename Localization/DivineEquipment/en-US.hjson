{
  "Mods": {
    "StarfallThrone": {
      "Items": {
        "DivineWeapon0": {
          "DisplayName": "Dewbranch Pruner",
          "Tooltip": "Three real melee hits release a short-range crescent for 75% damage.\nEach swing charges once; crescents cannot charge another combo."
        },
        "DivineWeapon1": {
          "DisplayName": "Dewcrown Bow",
          "Tooltip": "Three consecutive arrows into the same enemy empower the next arrow.\nIts hit releases two delayed dew drops, each for 40% damage.\nConsumes one arrow per shot; converts ammunition to dew arrows."
        },
        "DivineWeapon2": {
          "DisplayName": "Prayer of Germination",
          "Tooltip": "Hold to charge, release a short-range expanding ring.\nCharge up to 1.5 seconds; ring deals 80%-150% weapon damage.\nPays 4 extra mana every 0.5 seconds; each ring hits each enemy once."
        },
        "DivineWeapon3": {
          "DisplayName": "Whitebud Attendant",
          "Tooltip": "Summons a marking-and-dashing attendant using 1 minion slot.\nAttack cycle: 1.5 seconds. Dismiss via its buff; cannot attack through walls."
        },
        "DivineWeapon4": {
          "DisplayName": "Oathbreaker Furnaceblade",
          "Tooltip": "Real melee hits charge 20 pressure, up to 100, once per swing.\nRight-click spends 100 pressure on five short-range heat waves.\nEach deals 45% damage, travelling about 16 tiles."
        },
        "DivineWeapon5": {
          "DisplayName": "Judgement Burstgun",
          "Tooltip": "Three-round bursts consume one bullet per round.\nEvery third round marks an enemy for 3 seconds.\nLater hits detonate the mark for 65% damage; 1-second per-owner/target cooldown."
        },
        "DivineWeapon6": {
          "DisplayName": "Ashen Scales",
          "Tooltip": "Alternates quick light fire (80% damage) and slower heavy fire (120%).\nBoth hitting one enemy within 2 seconds ignite a 55% damage burst.\nBurst cooldown: 1.5 seconds per owner and target."
        },
        "DivineWeapon7": {
          "DisplayName": "Oathfurnace Guardian",
          "Tooltip": "Summons a guard-then-slam guardian using 2 minion slots.\nAttack cycle: 2 seconds. Its guard is a windup, not player protection."
        },
        "DivineWeapon8": {
          "DisplayName": "Fatecleaver",
          "Tooltip": "Hits leave a stationary slash that repeats after 1/3 second for 60% damage.\nRepeated slashes cannot create more slashes."
        },
        "DivineWeapon9": {
          "DisplayName": "Final Tick Bow",
          "Tooltip": "Fast arrows leave a stationary echo that strikes after 1/3 second.\nEcho radius: 4.5 tiles; damage: 50%; no homing or recursive echoes.\nConsumes one arrow per shot."
        },
        "DivineWeapon10": {
          "DisplayName": "Noonday Scripture",
          "Tooltip": "Left-click releases up to six hovering clock blades.\nRight-click costs 30 base mana to converge uncommitted blades at the cursor.\nTarget must be within 45 tiles and visible; each blade penetrates three times.\nMaximum lifetime 2.5 seconds, never extended by converging."
        },
        "DivineWeapon11": {
          "DisplayName": "Fatewheel Standardbearer",
          "Tooltip": "Summons a standardbearer using 2 minion slots; attack cycle: 2.4 seconds.\nAlternates a thrust with three stationary-array lances dealing 45% damage.\nChanging targets restarts deployment."
        },
