      "Items": {
        "EcologySummon0": {
          "DisplayName": "Mistmirrored Branch Crown",
          "Tooltip": "Summons Mistcrowned Huntsman\nRequires Eye of Cthulhu defeated in this world\nUse in an ecology-mode Mistmirror Grove with at least 600 matching terrain tiles\nSummon at night; dawn does not enrage an ongoing fight\nNot consumed; no other boss may be active"
        },
        "EcologySummon1": {
          "DisplayName": "Unquenched Wax Seal",
          "Tooltip": "Summons Thousand-Candle Sepulcher\nRequires Eater of Worlds or Brain of Cthulhu defeated in this world\nUse in an ecology-mode Waxsleep Court with at least 600 matching terrain tiles\nCan be summoned at any time\nNot consumed; no other boss may be active"
        },
        "EcologySummon2": {
          "DisplayName": "Honeysealed Brood Sac",
          "Tooltip": "Summons Amber Broodkeeper\nRequires Queen Bee defeated in this world\nUse in an ecology-mode Amberhive Thicket with at least 600 matching terrain tiles\nCan be summoned at any time\nNot consumed; no other boss may be active"
        },
        "EcologySummon3": {
          "DisplayName": "Silent Hanging Bell",
          "Tooltip": "Summons Hollow Bell Undertaker\nRequires Skeletron defeated in this world\nUse in an ecology-mode Knellbone Moor with at least 600 matching terrain tiles\nSummon at night; dawn does not enrage an ongoing fight\nNot consumed; no other boss may be active"
        },
        "EcologySummon4": {
          "DisplayName": "Inverted Ember",
          "Tooltip": "Summons Backburn Crucible\nRequires Wall of Flesh defeated in this world\nUse in an ecology-mode Backburn Wastes with at least 600 matching terrain tiles\nCan be summoned at any time\nNot consumed; no other boss may be active"
        },
        "EcologySummon5": {
          "DisplayName": "Failed Master Controller",
          "Tooltip": "Summons Wasteland Mainframe\nRequires all three mechanical bosses defeated in this world\nUse in an ecology-mode Wildmachine Soil with at least 600 matching terrain tiles\nCan be summoned at any time\nNot consumed; no other boss may be active"
        },
        "EcologySummon6": {
          "DisplayName": "Unripe Hungerfruit",
          "Tooltip": "Summons Thousand-Maw Blossom\nRequires Plantera defeated in this world\nUse in an ecology-mode Hungerbloom Garden with at least 600 matching terrain tiles\nCan be summoned at any time\nNot consumed; no other boss may be active"
        },
        "EcologySummon7": {
          "DisplayName": "Cooled Sunwheel",
          "Tooltip": "Summons Sunken-Sun Tombguard\nRequires Golem defeated in this world\nUse in an ecology-mode Sunken-Sun Domain with at least 600 matching terrain tiles\nCan be summoned at any time\nNot consumed; no other boss may be active"
        },
        "EcologySummon8": {
          "DisplayName": "Harmonic Tide Pearl",
          "Tooltip": "Summons Prismatic Tideweaver\nRequires both Duke Fishron and Empress of Light defeated in this world\nUse in an ecology-mode Rainbow Abyss with at least 600 matching terrain tiles\nCan be summoned at any time\nNot consumed; no other boss may be active"
        },
        "EcologySummon9": {
          "DisplayName": "Derailed Star Marker",
          "Tooltip": "Summons Formless Starpatroller\nRequires Moon Lord defeated in this world\nUse in an ecology-mode Formless Starsoil with at least 600 matching terrain tiles\nSummon at night; dawn does not enrage an ongoing fight\nNot consumed; no other boss may be active"
        }
