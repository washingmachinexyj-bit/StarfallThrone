      "Items": {
        "EcologySummon0": {
          "DisplayName": "映雾枝冠",
          "Tooltip": "召唤雾冠巡狩者\n需在本世界击败克苏鲁之眼\n在生态模式的雾镜林地中使用，至少需要600个对应地形块\n仅限夜间召唤；黎明不会使已开始的战斗狂暴\n非消耗品；场上不能存在其他Boss"
        },
        "EcologySummon1": {
          "DisplayName": "未熄蜡印",
          "Tooltip": "召唤千烛合葬者\n需在本世界击败世界吞噬怪或克苏鲁之脑\n在生态模式的蜡眠荒庭中使用，至少需要600个对应地形块\n白天或夜间均可召唤\n非消耗品；场上不能存在其他Boss"
        },
        "EcologySummon2": {
          "DisplayName": "封蜜育巢囊",
          "Tooltip": "召唤琥珀育巢者\n需在本世界击败蜂王\n在生态模式的蜜珀蚀林中使用，至少需要600个对应地形块\n白天或夜间均可召唤\n非消耗品；场上不能存在其他Boss"
        },
        "EcologySummon3": {
          "DisplayName": "无声吊钟",
          "Tooltip": "召唤空钟送葬者\n需在本世界击败骷髅王\n在生态模式的鸣骸墓原中使用，至少需要600个对应地形块\n仅限夜间召唤；黎明不会使已开始的战斗狂暴\n非消耗品；场上不能存在其他Boss"
        },
        "EcologySummon4": {
          "DisplayName": "倒燃火种",
          "Tooltip": "召唤逆燃熔心\n需在本世界击败血肉墙\n在生态模式的逆烬熔原中使用，至少需要600个对应地形块\n白天或夜间均可召唤\n非消耗品；场上不能存在其他Boss"
        },
        "EcologySummon5": {
          "DisplayName": "失效总控器",
          "Tooltip": "召唤荒原总机\n需在本世界击败全部三个机械 Boss\n在生态模式的失控械土中使用，至少需要600个对应地形块\n白天或夜间均可召唤\n非消耗品；场上不能存在其他Boss"
        },
        "EcologySummon6": {
          "DisplayName": "不熟之果",
          "Tooltip": "召唤万胃繁花\n需在本世界击败世纪之花\n在生态模式的永饥花庭中使用，至少需要600个对应地形块\n白天或夜间均可召唤\n非消耗品；场上不能存在其他Boss"
        },
        "EcologySummon7": {
          "DisplayName": "失温日轮",
          "Tooltip": "召唤沉日守陵兽\n需在本世界击败石巨人\n在生态模式的沉日遗境中使用，至少需要600个对应地形块\n白天或夜间均可召唤\n非消耗品；场上不能存在其他Boss"
        },
        "EcologySummon8": {
          "DisplayName": "虹潮合鸣珠",
          "Tooltip": "召唤虹渊织潮者\n需在本世界击败猪龙鱼公爵和光之女皇（两者均需击败）\n在生态模式的虹渊潮境中使用，至少需要600个对应地形块\n白天或夜间均可召唤\n非消耗品；场上不能存在其他Boss"
        },
        "EcologySummon9": {
          "DisplayName": "失轨星标",
          "Tooltip": "召唤无相巡星者\n需在本世界击败月亮领主\n在生态模式的无相星壤中使用，至少需要600个对应地形块\n仅限夜间召唤；黎明不会使已开始的战斗狂暴\n非消耗品；场上不能存在其他Boss"
        }
