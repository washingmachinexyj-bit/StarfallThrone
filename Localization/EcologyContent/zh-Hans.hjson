        "EcologyBag0": {
          "DisplayName": "雾冠巡狩者宝藏袋",
          "Tooltip": "右键打开\n内含核心 ×30–40、四职业武器随机一件和必得的专家饰品\n另有金币、治疗药水；1/7 概率获得面具"
        },
        "EcologyBar0": {
          "DisplayName": "雾镜晶锭",
          "Tooltip": "3 块矿石熔炼为 1 锭\n用于本生态装备、组件与工造配方"
        },
        "EcologyComponent0": {
          "DisplayName": "折镜棱片",
          "Tooltip": "由对应矿锭 ×2 和普通生态材料 ×3 制作\n用于本分支进阶装备与工造配方"
        },
        "EcologyTool0": {
          "DisplayName": "裂雾镐",
          "Tooltip": "镐力 50%；用本生态 Boss 核心与原版金属制作\n无需先挖本生态矿石\n本模组生态镐具不能在击败石巨人前开采神庙砖"
        },
        "EcologyMineralSeed0": {
          "DisplayName": "雾镜林地结晶种",
          "Tooltip": "手持结晶种右键同生态的矿床槽；上方预留 3×3 空间\n一枚生成 9 块可挖掘矿石；需要本世界击败对应生态 Boss\n仍需正确镐力；每枚消耗核心 ×1 和石块 ×30，不可直接种植"
        },
