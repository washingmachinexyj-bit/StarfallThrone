    BossChecklist: {
      SlimeEmperor: { SpawnInfo: "击败月亮领主后，使用皇帝王冠。" DespawnMessage: "帝国凝胶融入了星空。" }
      TerminalEye: { SpawnInfo: "击败史莱姆皇帝后，使用终焉之眼。" DespawnMessage: "终焉魔眼失去了目标。" }
      InfiniteDevourer: { SpawnInfo: "击败终焉魔眼后，使用无尽虫饵。" DespawnMessage: "无尽吞噬者钻回了虚空。" }
      CrimsonMind: { SpawnInfo: "击败无尽吞噬者后，使用猩红心髓。" DespawnMessage: "猩红心念逐渐消散。" }
      BeeMatriarch: { SpawnInfo: "击败猩红心魔后，使用蜂后圣印。" DespawnMessage: "蜂巢重新陷入寂静。" }
      SkeletalJudge: { SpawnInfo: "击败蜂后圣母后，在夜晚使用升格骨笛。" DespawnMessage: "骸骨审判被延期了。" }
      EternalWall: { SpawnInfo: "击败骸骨审判官后，在地狱使用永劫巫毒娃娃。" DespawnMessage: "永劫肉墙回到了灰烬中。" }
      DynastyQueen: { SpawnInfo: "击败永劫肉墙后，使用王朝棱晶。" DespawnMessage: "棱晶王座崩塌了。" }
      TwinCalamity: { SpawnInfo: "击败史莱姆女皇·王朝后，使用双生灾兆。" DespawnMessage: "双生引擎失去了同步。" }
      PrimeVerdict: { SpawnInfo: "击败双生天灾后，使用终审骷髅符。" DespawnMessage: "机械终审被撤回。" }
      StarEater: { SpawnInfo: "击败机械终审后，使用吞星机械虫。" DespawnMessage: "钢铁吞星者钻入了虚空。" }
      WastelandFlower: { SpawnInfo: "击败钢铁吞星者后，在地下丛林使用荒原花芽。" DespawnMessage: "荒原花神回到了沉眠的根系。" }
      TempleCore: { SpawnInfo: "击败荒原花神后，在神庙内使用神殿天心。" DespawnMessage: "神殿核心封闭了自己。" }
      AbyssalDuke: { SpawnInfo: "击败神殿核心后，在海洋使用深渊诱饵。" DespawnMessage: "深渊潮汐吞没了公爵。" }
      CoronaEmpress: { SpawnInfo: "击败深渊公爵后，在神圣之地使用日冕蝶印。" DespawnMessage: "日冕消失在了地平线外。" }
      AstralPontiff: { SpawnInfo: "击败光耀女皇·日冕后，在地牢使用星界教典。" DespawnMessage: "星界布道结束了。" }
      EndMoon: { SpawnInfo: "击败星界教皇后，使用月神终焉仪。" DespawnMessage: "月神终焉离开了战场。" }
      ResinWhelp: { SpawnInfo: "使用树脂橡果。" DespawnMessage: "树脂幼兽缩回了树根。" }
      CopperveinScarab: { SpawnInfo: "击败树脂幼兽后，使用熔铸甲壳。" DespawnMessage: "铜脉甲虫钻入地下。" }
      BellscorpionMatriarch: { SpawnInfo: "击败铜脉甲虫后，使用沙鸣铃。" DespawnMessage: "沙鸣蝎后消失在沙尘中。" }
      FrosthornStalker: { SpawnInfo: "击败沙鸣蝎后后，使用霜角骨笛。" DespawnMessage: "霜角猎兽逃入雪幕。" }
      LanternMiretoad: { SpawnInfo: "击败霜角猎兽后，使用沼灯诱饵。" DespawnMessage: "沼灯吞蛙沉入泥潭。" }
      WaxenArbiter: { SpawnInfo: "击败沼灯吞蛙后，使用蜂蜡印章。" DespawnMessage: "蜂蜡巡裁者返回蜂巢。" }
      RotrootWeaver: { SpawnInfo: "击败蜂蜡巡裁者后，使用邪根图腾。" DespawnMessage: "腐根织母潜入邪根。" }
      GravebellKeybearer: { SpawnInfo: "击败腐根织母后，使用墓钟钥匙。" DespawnMessage: "墓钟执钥者回到墓门之后。" }
      MeteorMaw: { SpawnInfo: "击败墓钟执钥者后，使用陨星胃石。" DespawnMessage: "陨铁噬星兽吞入了最后一颗星。" }
      DawnshardScion: { SpawnInfo: "击败陨铁噬星兽后，使用初辉徽印。" DespawnMessage: "初辉王胚熄灭在黎明之前。" }
    }
  }
}
