{
  "Mods": {
    "StarfallThrone": {
      "Items": {
        "AscendantWeapon0": {
          "DisplayName": "八芽裁生",
          "Tooltip": "三段交替挥斩；每次挥斩真正命中仅积累一次枝芽，最多3枚\n每第三次有效命中释放两道40%伤害的交叉枝刃\n右键消耗3枚枝芽，在准星附近释放两道85%伤害的合拢枝刃\n右键最远10格，不可选在墙后；枝刃不会积累连击"
        },
        "AscendantWeapon1": {
          "DisplayName": "万籽晨弦",
          "Tooltip": "箭矢命中同一敌人积累种印，3秒内第三次命中释放两枚65%伤害的追击露籽\n露籽先向两侧散开，再追击附近可见敌人；不会继续生成种印\n每次射击消耗一支箭，转换为晨籽箭"
        },
        "AscendantWeapon2": {
          "DisplayName": "初世花典",
          "Tooltip": "左键在准星处种下露花，最多3朵，各存在10秒\n右键依次引爆露花，间隔1/6秒，各释放100%伤害的扩散露环\n同一露环只命中每个敌人一次；放置最远45格且不能穿墙\n右键消耗4点基础魔力；露花未引爆时不造成伤害"
        },
        "AscendantWeapon3": {
          "DisplayName": "八生侍芽杖",
          "Tooltip": "召唤八生侍芽，先突刺，再散射两枚40%伤害的种弹\n每只占1个仆从栏位，完整攻击周期1.75秒\n取消增益即可遣散；服从原生召唤标记，不穿墙攻击"
        },
        "AscendantWeapon4": {
          "DisplayName": "四誓断罪刃",
          "Tooltip": "命中积累20点炉压，最多100，每次挥斩仅积累一次\n右键消耗100炉压，按镜、烛、巢、钟顺序释放四律热浪\n每道造成72%伤害，间隔1/6秒，最远约23格\n巢焰摆动，钟波更宽；热浪不能再次积累炉压"
        },
        "AscendantWeapon5": {
          "DisplayName": "审律四重铳",
          "Tooltip": "四发点射；每发消耗一颗子弹，转换为审律弹\n每轮前三发留下誓印，第四发命中时结算该目标本轮全部命中\n每层造成25%伤害的小范围爆燃，最多4层\n誓印最多存在1.5秒，不跨射击轮次累积；爆燃不递归"
        },
        "AscendantWeapon6": {
          "DisplayName": "四境焚典",
          "Tooltip": "左键依次施加镜、烛、巢、钟四种律印，律印持续4秒\n右键消耗28点基础魔力，结算45格内可见敌人的律印\n每种律印造成45%伤害的爆燃，同种印记不叠加\n结算消耗律印，爆燃不会再施加律印"
        },
        "AscendantWeapon7": {
          "DisplayName": "四炉执刑杖",
          "Tooltip": "召唤四炉执刑者：镜刃突击、烛焰直射、双巢焰、重钟弹依次接力\n后三式分别造成60%、两次30%、80%伤害\n每名占2个仆从栏位，完整攻击周期约2.67秒\n服从原生召唤标记；取消增益遣散，不提供玩家护盾"
        },
        "AscendantWeapon8": {
          "DisplayName": "终命裁界锋",
          "Tooltip": "挥斩首次命中在原位置留下65%伤害的命痕，最多5道，各存在5秒\n右键按命痕生成顺序重演，间隔约0.13秒\n命痕不追踪目标；未激活时无伤害，重演不会生成新命痕"
        },
        "AscendantWeapon9": {
          "DisplayName": "第五终刻",
          "Tooltip": "连续命中同一敌人三箭后，下一箭附带两道60%伤害的交叉回响\n回响在命中位置预告1/3秒后生效，不追踪目标，不递归\n每次射击消耗一支箭，转换为终刻命矢"
        },
        "AscendantWeapon10": {
          "DisplayName": "未发生之书",
          "Tooltip": "左键放置最多5枚刻度星，各存在10秒；未连线时没有伤害\n右键消耗30点基础魔力，连接相邻星点并消耗所有星点\n连线预告0.1秒后切割，每次造成110%伤害，最多命中3次\n同类连线对同一敌人共享0.2秒命中间隔；放置最远45格，不穿墙"
        },
        "AscendantWeapon11": {
          "DisplayName": "五轮司命权杖",
          "Tooltip": "召唤在追击突刺与五轮布阵间交替的司命者\n追击后发射两枚35%伤害命矛，布阵依次释放五种命轮攻击\n每名占2个仆从栏位，完整循环约5.33秒\n原生召唤标记可指定集火目标；取消增益遣散，不穿墙攻击"
        },
