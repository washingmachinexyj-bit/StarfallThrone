        "AscendantExpert0": {
          "DisplayName": "Sacred Heart of Eight Lives",
          "Tooltip": "Increases maximum life by 35\nPrepares a 50-damage dew shield every 15 seconds; the shield may absorb several enemy hits\nWhen enemy attacks deplete it, gain 15% movement speed for 3 seconds\nGrants no extra immunity; does not block environment, self-inflicted or PvP damage\nIncompatible with the Uncrowned Sacred Heart; unequipping, death and world entry do not reset cooldown"
        },
        "AscendantExpert1": {
          "DisplayName": "Undying Heart of Four Laws",
          "Tooltip": "Increases maximum life by 60\nAfter a nonlethal enemy hit, records 40% of its damage, up to 90 life\nAfter 4 seconds without injury, refunds 1 life every approximately 0.067 seconds; 20-second trigger cooldown\nAnother injury, unequipping or death cancels remaining refund; environment, self-damage, traps and PvP cannot trigger it\nCannot revive; incompatible with the Unquenchable Second Heart; world entry does not reset cooldown"
        },
        "AscendantExpert2": {
          "DisplayName": "The Rejected Ending",
          "Tooltip": "Increases all damage by 12%\nPrepares a fate veil every 25 seconds\nReduces the next enemy hit expected to deal at least 60 damage by 60%, capped at 180 damage prevented\nNever grants complete immunity or revival; excludes environment, self-inflicted and PvP damage\nIncompatible with the Ending Yet to Happen; unequipping, death and world entry do not reset cooldown"
        }
