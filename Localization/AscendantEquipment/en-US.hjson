{
  "Mods": {
    "StarfallThrone": {
      "Items": {
        "AscendantWeapon0": {
          "DisplayName": "Eightfold Budcleaver",
          "Tooltip": "Alternates three slashes; each successful swing earns one bud, up to 3\nEvery third successful swing launches two crossing branches at 40% damage each\nRight-click spends 3 buds to close two branches on the cursor, each at 85% damage\nAlternate range: 10 tiles with line of sight; branches cannot build combos"
        },
        "AscendantWeapon1": {
          "DisplayName": "Dawnseed Bow",
          "Tooltip": "Three hits on the same enemy within 3 seconds release two pursuing seeds at 65% damage each\nSeeds first scatter sideways, then seek nearby visible enemies; seeds cannot apply marks\nConsumes one arrow per shot and converts it into a dawnseed arrow"
        },
        "AscendantWeapon2": {
          "DisplayName": "Codex of First Bloom",
          "Tooltip": "Left-click places up to 3 dew flowers, each lasting 10 seconds\nRight-click detonates them in placement order at 1/6-second intervals, each making a 100% damage expanding ring\nEach ring hits each enemy once; placement range 45 tiles with line of sight\nAlternate fire costs 4 base mana; inactive flowers deal no damage"
        },
        "AscendantWeapon3": {
          "DisplayName": "Eightlife Attendant Staff",
          "Tooltip": "Summons an attendant that lunges, then scatters two seeds at 40% damage each\nEach attendant uses 1 minion slot; full attack cycle: 1.75 seconds\nCancel the buff to dismiss; obeys native minion targeting and cannot attack through walls"
        },
        "AscendantWeapon4": {
          "DisplayName": "Four-Oath Verdict",
          "Tooltip": "Successful swings build 20 furnace pressure, up to 100, once per swing\nRight-click spends 100 pressure to release mirror, candle, hive and bell waves in sequence\nEach deals 72% damage at 1/6-second intervals, reaching approximately 23 tiles\nHive waves sway and bell waves are wider; waves cannot build pressure"
        },
        "AscendantWeapon5": {
          "DisplayName": "Fourfold Judgment",
          "Tooltip": "Fires four-shot bursts, consuming and converting one bullet per shot\nThe first three shots mark targets; a fourth-shot hit detonates that target's hits from this burst\nEach mark deals 25% damage in a small explosion, up to 4 marks\nMarks last 1.5 seconds and cannot carry between bursts; explosions do not recurse"
        },
        "AscendantWeapon6": {
          "DisplayName": "Codex of Burning Realms",
          "Tooltip": "Left-click cycles mirror, candle, hive and bell marks lasting 4 seconds\nRight-click spends 28 base mana to consume marks on visible enemies within 45 tiles\nEach distinct mark adds 45% explosion damage; identical marks do not stack\nExplosions consume marks and cannot apply more"
        },
        "AscendantWeapon7": {
          "DisplayName": "Four-Furnace Executioner Staff",
          "Tooltip": "Summons an executioner cycling a mirror lunge, candle shot, twin hive shots and a heavy bell shot\nThe last three attacks deal 60%, two times 30%, and 80% damage respectively\nEach uses 2 minion slots; full cycle: approximately 2.67 seconds\nObeys native minion targeting; cancel buff to dismiss; grants no player shield"
        },
        "AscendantWeapon8": {
          "DisplayName": "Fatecleaving Edge",
          "Tooltip": "The first hit of each swing leaves a stationary 65% damage fate scar, up to 5, lasting 5 seconds\nRight-click replays scars in placement order, approximately 0.13 seconds apart\nScars cannot track targets, are harmless until triggered, and cannot generate more scars"
        },
        "AscendantWeapon9": {
          "DisplayName": "The Fifth Final Hour",
          "Tooltip": "Three consecutive hits on one enemy empower the next arrow with two crossing echoes at 60% damage each\nEchoes telegraph for 1/3 second at the impact position, without tracking or recursion\nConsumes one arrow per shot and converts it into a final-hour arrow"
        },
        "AscendantWeapon10": {
          "DisplayName": "Book of the Unhappened",
          "Tooltip": "Left-click places up to 5 harmless clock stars, each lasting 10 seconds\nRight-click spends 30 base mana to connect adjacent stars and consume them all\nLinks telegraph for 0.1 seconds, then deal 110% damage per hit, up to 3 hits\nAll links of this type share a 0.2-second hit interval per enemy; placement range 45 tiles with line of sight"
        },
        "AscendantWeapon11": {
          "DisplayName": "Five-Wheel Fatekeeper",
          "Tooltip": "Summons a fatekeeper alternating pursuit lunges and five-wheel formations\nAfter pursuit it fires two lances at 35% damage, then deploys five distinct wheel attacks\nEach uses 2 minion slots; full cycle: approximately 5.33 seconds\nObeys native target designation; cancel buff to dismiss; cannot attack through walls"
        },
