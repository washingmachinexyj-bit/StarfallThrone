      Node10: "Forge vent - release pressure"
      Node11: "Seed husk - cover or hatchery"
      Node12: "Pillar core - cover and gravity anchor"
      Node13: "Storm node - stabilize the eye"
      Node14: "Wing seal - silence its light law"
      Node15: "Divine page - reorder and erase"
      Node16: "Divinity source - suppress authority"
      Move0_0: "Creation's landing - cross the ring gap"
      Move0_1: "Three first forms - orb, blade, wing"
      Move0_2: "Return to the first drop"
      Move1_0: "Committed gaze - leave the marked line"
