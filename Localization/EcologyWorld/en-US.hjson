{
  "Mods": {
    "StarfallThrone": {
      "Items": {
        "EcologyAnchor": {
          "DisplayName": "Region Anchor",
          "Tooltip": "Right-click to preview and confirm a rectangular biome region\nDoes not convert terrain automatically; never spreads naturally\nUnbinding or breaking the anchor leaves blocks but disables its ecology"
        },
        "EcologyBoundaryScanner": {
          "DisplayName": "Boundary Scanner",
          "Tooltip": "Right-click a region anchor, then select two corners with this scanner\nConfirm in the anchor panel; shows boundaries and ecological block counts"
        },
        "EcologySprayCan": {
          "DisplayName": "Ecological Sprayer",
          "Tooltip": "Consumes ecological solution at short range\nAccepts only this mod's solutions; works inside your bound regions"
        },
        "EcologyRestorePowder": {
          "DisplayName": "Restoration Powder",
          "Tooltip": "Restores your region's ecological blocks to matching vanilla stone/dirt/grass/sand/ice\nDoes not affect ores or other mods' blocks; consumed only on successful conversion"
        },
        "EcologyRestoreSolution": {
          "DisplayName": "Restoration Solution",
          "Tooltip": "For the Ecological Sprayer, Clentaminator or Terraformer\nRestores only this mod's base ecological blocks in your own region"
        },
        "EcologyMineralBed": {
          "DisplayName": "Ecological Mineral Bed",
          "Tooltip": "Place in your active region; hold its mineral seed and right-click\nGrows nine mineable ore blocks in the empty 3×3 space above after 30 seconds\nRequires its defeated boss; breaking the bed refunds its unfinished seed"
        },
        "EcologyOre0": {
          "DisplayName": "Mistmirror Ore",
          "Tooltip": "Requires 45% pickaxe power and Mistcrowned Pursuer's defeat in this world\nCrystallizes inside matching regions; renewable with mineral beds"
        },
        "EcologyCatalyst0": {
          "DisplayName": "Mistmirror Catalyst",
          "Tooltip": "Crafts ecological powders and solutions\nUnlocked by Eye of Cthulhu; does not generate terrain automatically"
        },
        "EcologyPowder0": {
          "DisplayName": "Mistmirror Powder",
          "Tooltip": "Use on ordinary stone/dirt/grass/sand/ice in a 5×5 area within your matching region\nNo natural spreading; skips ores, furniture supports, walls, wires and liquids\nConsumed only when conversion succeeds"
        },
        "EcologySolution0": {
          "DisplayName": "Mistmirror Solution",
          "Tooltip": "For the Ecological Sprayer, Clentaminator or Terraformer\nOnly affects your matching region; no natural spreading"
        },
        "EcologyPlant0": {
          "DisplayName": "Mistmirror Herb",
          "Tooltip": "A herb from active ecology; crafts materials and regeneration potions\nDisplay mode grows no natural resources"
        },
        "EcologySeed0": {
          "DisplayName": "Mistmirror Seed",
          "Tooltip": "Plant on matching ecological grass\nHarvest yields resources only in an unlocked, active ecological region"
        },
        "EcologyWallItem0": {
          "DisplayName": "Mistmirror Wall",
          "Tooltip": "Safe decorative background wall suitable for housing\nDoes not spread or contribute to the ecological block count"
        },
        "EcologyBlock0_0": {
          "DisplayName": "Mistmirror Stone",
          "Tooltip": "Never spreads naturally; only activates ecology in a bound region\nRestoration powder returns it to the matching vanilla base block"
        },
