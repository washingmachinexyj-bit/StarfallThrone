{
  "Mods": {
    "StarfallThrone": {
      "Items": {
        "EcologyAnchor": {
          "DisplayName": "界域锚",
          "Tooltip": "右键预览并确认矩形生态范围\n锚点不会自动转化地形；无自然蔓延\n解除绑定或拆除后方块保留，专属生态停止"
        },
        "EcologyBoundaryScanner": {
          "DisplayName": "边界勘测仪",
          "Tooltip": "先右键界域锚，再左键选择两个对角\n在锚的面板中确认范围；显示生态数量与边界"
        },
        "EcologySprayCan": {
          "DisplayName": "生态喷壶",
          "Tooltip": "消耗生态溶液，近距离创造或恢复界域方块\n仅接受本模组溶液；限自己绑定的界域"
        },
        "EcologyRestorePowder": {
          "DisplayName": "归原粉",
          "Tooltip": "将自己界域的生态方块恢复为对应原版石/土/草/沙/冰\n不影响矿物或其他模组方块；成功转换才消耗"
        },
        "EcologyRestoreSolution": {
          "DisplayName": "归原溶液",
          "Tooltip": "用于生态喷壶、环境改造枪或泰拉改造枪\n仅恢复自己界域内的本模组生态基础方块"
        },
        "EcologyMineralBed": {
          "DisplayName": "生态矿床槽",
          "Tooltip": "放在自己的活跃生态内；手持对应矿床种核右键\n30秒后在正上方3×3空地生成9块可挖矿物\n需击败对应生态 Boss；拆除时返还未完成批次的种核"
        },
        "EcologyOre0": {
          "DisplayName": "雾镜晶矿",
